# Build do front (Vite) servido pelo Caddy, que também faz o proxy /api → api:3333 e serve a landing page.
FROM node:22-bookworm-slim AS build
WORKDIR /app/apps/web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/web/ ./
RUN npm run build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/apps/web/dist /srv/app
# Landing padrão; em produção a pasta landing/ do projeto é montada por cima (editável sem rebuild).
COPY landing/ /srv/landing/
