// ============================================================================
// Sistema Clínica — schema do banco (PostgreSQL + Prisma)
//
// Convenções:
// - Nomes de tabelas/colunas em português, snake_case, sem acento.
// - Campos do Prisma já usam snake_case (ex.: `clinica_id`), iguais às colunas.
// - Modelos de PLATAFORMA não têm clinica_id: UsuarioPlataforma, Recurso, Plano,
//   PlanoRecurso, Clinica, Assinatura.
// - Modelos de CLÍNICA têm `clinica_id` obrigatório + índice. O default dbgenerated(current_setting('app.clinica_id'))
//   existe só para o campo ficar OPCIONAL nos tipos do create: a extensão tenant sempre injeta o valor do
//   token; se alguém criar sem clinica_id pelo prisma cru, o insert FALHA no banco (falha fechada). O filtro por tenant é
//   aplicado automaticamente pela extensão em src/plugins/tenant.ts (request.db).
//   Ao adicionar um modelo de clínica, inclua-o em MODELOS_DE_CLINICA nesse arquivo.
// - IDs são UUID.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum PapelUsuario {
  admin
  recepcao
  profissional

  @@map("papel_usuario")
}

enum StatusClinica {
  ativa
  inativa

  @@map("status_clinica")
}

enum StatusAssinatura {
  teste
  ativa
  vencida
  cancelada
  bloqueada

  @@map("status_assinatura")
}

enum TipoRecurso {
  limite
  booleano

  @@map("tipo_recurso")
}

enum PeriodoLimite {
  total
  mensal

  @@map("periodo_limite")
}

enum Sexo {
  feminino
  masculino
  outro

  @@map("sexo")
}

enum StatusAgendamento {
  agendado
  confirmado
  compareceu
  atendido
  cancelado
  faltou

  @@map("status_agendamento")
}

enum TipoAgendamento {
  particular
  convenio

  @@map("tipo_agendamento")
}

enum StatusSessaoWhatsapp {
  desconectada
  iniciando
  aguardando_qr
  conectada
  erro

  @@map("status_sessao_whatsapp")
}

enum TipoMensagem {
  lembrete
  confirmacao
  aviso
  /// Fase 2: solicitação de agendamento online aprovada ("sua consulta está agendada").
  agendamento_confirmado
  /// Fase 2: solicitação de agendamento online recusada (com motivo, opcional).
  agendamento_recusado
  /// Fase 2: oferta de horário vago para paciente da lista de espera.
  oferta_horario
  /// Fase 2: convite para agendar o retorno.
  convite_retorno

  @@map("tipo_mensagem")
}

enum DirecaoMensagem {
  entrada
  saida

  @@map("direcao_mensagem")
}

enum StatusMensagem {
  pendente
  enviada
  falhou
  recebida

  @@map("status_mensagem")
}

// --- Fase 2 do produto -------------------------------------------------------

enum FormaPagamento {
  dinheiro
  pix
  cartao_credito
  cartao_debito
  boleto
  transferencia
  convenio
  outro

  @@map("forma_pagamento")
}

enum TipoContaFinanceira {
  caixa
  banco
  carteira_digital
  outro

  @@map("tipo_conta_financeira")
}

enum TipoCategoriaFinanceira {
  receita
  despesa

  @@map("tipo_categoria_financeira")
}

enum TipoMovimentacao {
  entrada
  saida

  @@map("tipo_movimentacao")
}

/// De onde veio a movimentação (relatórios e regras de estorno).
enum OrigemMovimentacao {
  /// Lançamento avulso de entrada/saída.
  manual
  /// Recebimento vinculado a um agendamento (consulta).
  consulta
  /// Baixa de um título (conta a pagar/receber).
  titulo
  /// Pagamento de repasse/comissão ao profissional.
  repasse
  /// Estorno de outra movimentação (estorno_de_id preenchido).
  estorno

  @@map("origem_movimentacao")
}

enum TipoTitulo {
  pagar
  receber

  @@map("tipo_titulo")
}

/// "vencido" NÃO é status: é derivado (status = aberto e vencimento < hoje no fuso da clínica).
enum StatusTitulo {
  aberto
  pago
  cancelado

  @@map("status_titulo")
}

enum FrequenciaRecorrencia {
  mensal

  @@map("frequencia_recorrencia")
}

enum StatusSolicitacaoAgendamento {
  pendente
  aprovada
  recusada
  expirada

  @@map("status_solicitacao_agendamento")
}

enum StatusListaEspera {
  aguardando
  agendado
  removido

  @@map("status_lista_espera")
}

enum Turno {
  manha
  tarde
  noite

  @@map("turno")
}

enum TipoDocumentoClinico {
  receita
  atestado
  declaracao
  pedido_exame

  @@map("tipo_documento_clinico")
}

enum StatusRetorno {
  pendente
  agendado
  lembrado
  cancelado

  @@map("status_retorno")
}

/// Gateways de cobrança do SaaS (plataforma).
enum ProvedorPagamento {
  asaas
  stripe
  mercado_pago

  @@map("provedor_pagamento")
}

enum AmbienteGateway {
  sandbox
  producao

  @@map("ambiente_gateway")
}

enum MetodoCobranca {
  pix
  boleto
  cartao

  @@map("metodo_cobranca")
}

enum TipoEmail {
  boas_vindas
  redefinir_senha
  pagamento_confirmado
  aviso_renovacao
  pagamento_renovado

  @@map("tipo_email")
}

enum StatusEmail {
  pendente
  enviado
  falhou
  ignorado

  @@map("status_email")
}

enum StatusCobranca {
  pendente
  paga
  vencida
  cancelada
  estornada

  @@map("status_cobranca")
}

// ----------------------------------------------------------------------------
// Plataforma (sem clinica_id)
// ----------------------------------------------------------------------------

model UsuarioPlataforma {
  id            String   @id @default(uuid()) @db.Uuid
  nome          String
  email         String   @unique
  senha_hash    String
  ativo         Boolean  @default(true)
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  @@map("usuarios_plataforma")
}

/// Catálogo fixo de recursos (espelha CATALOGO_RECURSOS em src/plugins/recursos.ts).
model Recurso {
  codigo    String      @id
  nome      String
  descricao String?
  tipo      TipoRecurso
  ordem     Int         @default(0)

  planos PlanoRecurso[]

  @@map("recursos")
}

model Plano {
  id             String   @id @default(uuid()) @db.Uuid
  nome           String
  descricao      String?
  preco          Decimal  @default(0) @db.Decimal(10, 2)
  ativo          Boolean  @default(true)
  /// Plano atribuído no auto-cadastro. Só um pode estar marcado (índice parcial único na migration).
  plano_cadastro Boolean  @default(false)
  /// Aparece em "Planos" no painel da clínica para contratação com pagamento online (só planos pagos).
  contratavel    Boolean  @default(false)
  /// Aparece na landing page (GET /publico/planos).
  exibir_landing Boolean  @default(false)
  criado_em      DateTime @default(now())
  atualizado_em  DateTime @updatedAt

  recursos              PlanoRecurso[]
  assinaturas           Assinatura[]
  cobrancas_contratacao Cobranca[]

  @@map("planos")
}

model PlanoRecurso {
  id             String        @id @default(uuid()) @db.Uuid
  plano_id       String        @db.Uuid
  recurso_codigo String
  habilitado     Boolean       @default(true)
  /// null = ilimitado (para recursos do tipo `limite`).
  limite         Int?
  periodo        PeriodoLimite @default(total)

  plano   Plano   @relation(fields: [plano_id], references: [id], onDelete: Cascade)
  recurso Recurso @relation(fields: [recurso_codigo], references: [codigo])

  @@unique([plano_id, recurso_codigo])
  @@map("plano_recursos")
}

model Clinica {
  id            String        @id @default(uuid()) @db.Uuid
  nome          String
  /// CNPJ ou CPF, somente dígitos.
  documento     String        @unique
  responsavel   String?
  email         String?
  telefone      String?
  endereco      String?
  cidade        String?
  uf            String?       @db.VarChar(2)
  cep           String?
  fuso_horario  String        @default("America/Sao_Paulo")
  /// Identificador público (URL do agendamento online: /agendar/:slug). Minúsculas, dígitos e hífen.
  /// Gerado a partir do nome (utils/slug.ts) no auto-cadastro e pela migration fase2_produto;
  /// nullable só para não quebrar criações antigas/testes — sem slug, não há agendamento online.
  slug          String?       @unique
  status        StatusClinica @default(ativa)
  criado_em     DateTime      @default(now())
  atualizado_em DateTime      @updatedAt

  assinatura                Assinatura?
  cobrancas                 Cobranca[]
  configuracao              ConfiguracaoClinica?
  contas_financeiras        ContaFinanceira[]
  categorias_financeiras    CategoriaFinanceira[]
  movimentacoes_financeiras MovimentacaoFinanceira[]
  titulos                   Titulo[]
  recorrencias              Recorrencia[]
  solicitacoes_agendamento  SolicitacaoAgendamento[]
  lista_espera              ListaEspera[]
  documentos_clinicos       DocumentoClinico[]
  retornos                  Retorno[]
  usuarios                  Usuario[]
  profissionais             Profissional[]
  profissional_horarios     ProfissionalHorario[]
  bloqueios_agenda          BloqueioAgenda[]
  convenios                 Convenio[]
  pacientes                 Paciente[]
  paciente_alergias         PacienteAlergia[]
  paciente_medicacoes       PacienteMedicacao[]
  agendamentos              Agendamento[]
  prontuario_registros      ProntuarioRegistro[]
  anexos                    Anexo[]
  whatsapp_sessao           WhatsappSessao?
  mensagens_whatsapp        MensagemWhatsapp[]
  logs_acesso               LogAcesso[]
  emails_enviados           EmailEnviado[]

  @@map("clinicas")
}

/// Assinatura ATUAL da clínica (uma por clínica). Troca de plano = update.
model Assinatura {
  id                    String             @id @default(uuid()) @db.Uuid
  clinica_id            String             @unique @db.Uuid
  plano_id              String             @db.Uuid
  status                StatusAssinatura   @default(teste)
  inicio                DateTime           @default(now())
  /// null = não expira (ex.: teste grátis).
  expira_em             DateTime?
  /// Cobrança automática (fase 2): gateway em que a clínica é cobrada (null = cobrança manual).
  gateway               ProvedorPagamento?
  /// ID do cliente no gateway (Asaas customer, Stripe customer, Mercado Pago payer).
  cliente_externo_id    String?
  /// ID da assinatura recorrente no gateway (quando o gateway gerencia a recorrência).
  assinatura_externa_id String?
  /// Dia do mês (1–28) do vencimento da mensalidade.
  dia_vencimento        Int?               @db.SmallInt
  /// Método preferido da cobrança automática (null = o cliente escolhe no link do gateway).
  metodo_cobranca       MetodoCobranca?
  criado_em             DateTime           @default(now())
  atualizado_em         DateTime           @updatedAt

  clinica   Clinica    @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  plano     Plano      @relation(fields: [plano_id], references: [id])
  cobrancas Cobranca[]

  @@index([plano_id])
  @@index([gateway, assinatura_externa_id])
  @@map("assinaturas")
}

/// Configuração de um gateway de cobrança do SaaS (plataforma; um registro por provedor).
/// Credenciais SEMPRE cifradas (utils/cripto.ts, AES-256-GCM com CHAVE_CRIPTOGRAFIA); a API nunca
/// devolve o segredo em claro — só os últimos 4 caracteres (`*_final`).
/// Só um gateway pode estar ativo (índice único parcial em `ativo = true`, SQL manual na migration).
model GatewayPagamento {
  id                      String            @id @default(uuid()) @db.Uuid
  provedor                ProvedorPagamento @unique
  ambiente                AmbienteGateway   @default(sandbox)
  ativo                   Boolean           @default(false)
  /// JSON cifrado com as credenciais do provedor (ex.: { api_key } / { secret_key, publishable_key } / { access_token }).
  credenciais_cifradas    String?
  /// Últimos 4 caracteres da credencial principal (exibição).
  credenciais_final       String?           @db.VarChar(4)
  /// Segredo/token de validação do webhook, cifrado.
  segredo_webhook_cifrado String?
  segredo_webhook_final   String?           @db.VarChar(4)
  /// Dias após o vencimento antes de a assinatura virar `vencida`/`bloqueada`.
  dias_tolerancia         Int               @default(5)
  metodos                 MetodoCobranca[]  @default([pix, boleto])
  /// Dia do mês (1–28) sugerido ao ativar a cobrança recorrente de uma clínica.
  dia_vencimento_padrao   Int               @default(10) @db.SmallInt
  /// Modelo da descrição da cobrança: `{plano}` e `{competencia}` (MM/AAAA) são substituídos.
  descricao_cobranca      String            @default("Mensalidade do sistema — plano {plano} ({competencia})")
  criado_em               DateTime          @default(now())
  atualizado_em           DateTime          @updatedAt

  @@map("gateways_pagamento")
}

/// Cobrança (fatura) do SaaS para uma clínica (plataforma: tem clinica_id, mas NÃO é modelo de clínica.
/// Via request.db é somente leitura e filtrada pela clínica do token — ver tenant.ts).
model Cobranca {
  id                  String            @id @default(uuid()) @db.Uuid
  clinica_id          String            @db.Uuid
  assinatura_id       String?           @db.Uuid
  gateway             ProvedorPagamento
  /// ID da cobrança no gateway (payment id / invoice id).
  id_externo          String?
  descricao           String?
  valor               Decimal           @db.Decimal(10, 2)
  vencimento          DateTime          @db.Date
  status              StatusCobranca    @default(pendente)
  metodo              MetodoCobranca?
  link_pagamento      String?
  pago_em             DateTime?
  /// Contratação pela própria clínica (POST /contratacao): plano liberado quando esta cobrança for paga.
  plano_contratado_id String?           @db.Uuid
  /// Ambiente do gateway quando a cobrança foi gerada (null = anterior à migration `seguranca_fase2`, preenchido
  /// com o ambiente do gateway naquele momento). Pagamento de cobrança sandbox com gateway em produção é ignorado.
  ambiente            AmbienteGateway?
  /// Último payload relevante do gateway (auditoria).
  payload             Json?
  criado_em           DateTime          @default(now())
  atualizado_em       DateTime          @updatedAt

  clinica          Clinica     @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  assinatura       Assinatura? @relation(fields: [assinatura_id], references: [id], onDelete: SetNull)
  plano_contratado Plano?      @relation(fields: [plano_contratado_id], references: [id], onDelete: SetNull)

  @@unique([gateway, id_externo])
  @@index([clinica_id, vencimento])
  @@index([status, vencimento])
  @@map("cobrancas")
}

/// Webhooks recebidos dos gateways (plataforma). Idempotência: (gateway, id_evento) único.
model EventoGateway {
  id            String            @id @default(uuid()) @db.Uuid
  gateway       ProvedorPagamento
  id_evento     String
  tipo          String
  payload       Json
  processado_em DateTime?
  erro          String?
  recebido_em   DateTime          @default(now())

  @@unique([gateway, id_evento])
  @@index([recebido_em])
  @@map("eventos_gateway")
}

// ----------------------------------------------------------------------------
// Clínica (todas com clinica_id)
// ----------------------------------------------------------------------------

model Usuario {
  id                String       @id @default(uuid()) @db.Uuid
  clinica_id        String       @default(dbgenerated("(current_setting('app.clinica_id'::text))::uuid")) @db.Uuid
  nome              String
  email             String
  senha_hash        String
  papel             PapelUsuario
  /// Vínculo opcional com um profissional (obrigatório para papel `profissional`; opcional para `admin`).
  profissional_id   String?      @unique @db.Uuid
  ativo             Boolean      @default(true)
  ultimo_acesso_em  DateTime?
  /// Última troca/redefinição de senha: tokens emitidos antes disso são recusados (autenticarClinica).
  senha_alterada_em DateTime?
  criado_em         DateTime     @default(now())
  atualizado_em     DateTime     @updatedAt

  clinica      Clinica       @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  profissional Profissional? @relation(fields: [profissional_id], references: [id], onDelete: SetNull)

  agendamentos_criados  Agendamento[]            @relation("AgendamentoCriadoPor")
  registros_prontuario  ProntuarioRegistro[]     @relation("RegistroAutor")
  anexos_enviados       Anexo[]                  @relation("AnexoEnviadoPor")
  logs_acesso           LogAcesso[]
  tokens_redefinicao    TokenRedefinicaoSenha[]
  documentos_emitidos   DocumentoClinico[]       @relation("DocumentoAutor")
  movimentacoes_criadas MovimentacaoFinanceira[] @relation("MovimentacaoCriadaPor")

  @@unique([clinica_id, email])
  @@index([clinica_id])
  @@index([email])
  @@map("usuarios")
}

model Profissional {
  id                   String   @id @default(uuid()) @db.Uuid
  clinica_id           String   @default(dbgenerated("(current_setting('app.clinica_id'::text))::uuid")) @db.Uuid
  nome                 String
  especialidade        String?
  /// CRM, CRO, CRP… (texto livre)
  registro             String?
  telefone             String?
  email                String?
  duracao_consulta_min Int      @default(30)
  cor_agenda           String   @default("#0d9488")
  ativo                Boolean  @default(true)
  /// Fase 2 (financeiro): % de repasse/comissão sobre as entradas vinculadas ao profissional (0–100; null = sem repasse).
  percentual_repasse   Decimal? @db.Decimal(5, 2)
  /// Fase 2 (agendamento online): aparece na página pública /agendar/:slug.
  agendamento_online   Boolean  @default(true)
  criado_em            DateTime @default(now())
  atualizado_em        DateTime @updatedAt

  clinica                   Clinica                  @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  usuario                   Usuario?
  horarios                  ProfissionalHorario[]
  bloqueios                 BloqueioAgenda[]
  agendamentos              Agendamento[]
  registros                 ProntuarioRegistro[]
  movimentacoes_financeiras MovimentacaoFinanceira[]
  titulos                   Titulo[]
  recorrencias              Recorrencia[]
  solicitacoes_agendamento  SolicitacaoAgendamento[]
  lista_espera              ListaEspera[]
  documentos_clinicos       DocumentoClinico[]
  retornos                  Retorno[]

  @@index([clinica_id])
  @@index([clinica_id, ativo])
  @@map("profissionais")
}

/// Grade semanal de atendimento. dia_semana: 0 = domingo … 6 = sábado. Horas "HH:mm" (fuso da clínica).
model ProfissionalHorario {
  id              String   @id @default(uuid()) @db.Uuid
  clinica_id      String   @default(dbgenerated("(current_setting('app.clinica_id'::text))::uuid")) @db.Uuid
  profissional_id String   @db.Uuid
  dia_semana      Int      @db.SmallInt
  hora_inicio     String   @db.VarChar(5)
  hora_fim        String   @db.VarChar(5)
  criado_em       DateTime @default(now())

  clinica      Clinica      @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  profissional Profissional @relation(fields: [profissional_id], references: [id], onDelete: Cascade)

  @@index([clinica_id])
  @@index([clinica_id, profissional_id])
  @@map("profissional_horarios")
}

/// Bloqueio de agenda. profissional_id null = clínica toda (feriado, recesso…).
model BloqueioAgenda {
  id              String   @id @default(uuid()) @db.Uuid
  clinica_id      String   @default(dbgenerated("(current_setting('app.clinica_id'::text))::uuid")) @db.Uuid
  profissional_id String?  @db.Uuid
  inicio          DateTime
  fim             DateTime
  motivo          String?
  criado_em       DateTime @default(now())

  clinica      Clinica       @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  profissional Profissional? @relation(fields: [profissional_id], references: [id], onDelete: Cascade)

  @@index([clinica_id])
  @@index([clinica_id, inicio])
  @@map("bloqueios_agenda")
}

model Convenio {
  id            String   @id @default(uuid()) @db.Uuid
  clinica_id    String   @default(dbgenerated("(current_setting('app.clinica_id'::text))::uuid")) @db.Uuid
  nome          String
  ativo         Boolean  @default(true)
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  clinica      Clinica       @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  pacientes    Paciente[]
  agendamentos Agendamento[]

  @@unique([clinica_id, nome])
  @@index([clinica_id])
  @@map("convenios")
}

model Paciente {
  id                 String    @id @default(uuid()) @db.Uuid
  clinica_id         String    @default(dbgenerated("(current_setting('app.clinica_id'::text))::uuid")) @db.Uuid
  nome               String
  /// Somente dígitos.
  cpf                String?
  nascimento         DateTime? @db.Date
  sexo               Sexo?
  telefone           String?
  /// Número no formato internacional só com dígitos (ex.: 5511999998888).
  whatsapp           String?
  email              String?
  endereco           String?
  convenio_id        String?   @db.Uuid
  numero_carteirinha String?
  contato_emergencia String?
  /// Consentimento LGPD para receber mensagens de WhatsApp.
  aceita_whatsapp    Boolean   @default(false)
  observacoes        String?
  ativo              Boolean   @default(true)
  criado_em          DateTime  @default(now())
  atualizado_em      DateTime  @updatedAt

  clinica                   Clinica                  @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  convenio                  Convenio?                @relation(fields: [convenio_id], references: [id], onDelete: SetNull)
  alergias                  PacienteAlergia[]
  medicacoes                PacienteMedicacao[]
  agendamentos              Agendamento[]
  registros                 ProntuarioRegistro[]
  anexos                    Anexo[]
  mensagens                 MensagemWhatsapp[]
  movimentacoes_financeiras MovimentacaoFinanceira[]
  titulos                   Titulo[]
  recorrencias              Recorrencia[]
  solicitacoes_agendamento  SolicitacaoAgendamento[]
  lista_espera              ListaEspera[]
  documentos_clinicos       DocumentoClinico[]
  retornos                  Retorno[]

  @@unique([clinica_id, cpf])
  @@index([clinica_id])
  @@index([clinica_id, nome])
  @@index([clinica_id, whatsapp])
  @@map("pacientes")
}

model PacienteAlergia {
  id          String   @id @default(uuid()) @db.Uuid
  clinica_id  String   @default(dbgenerated("(current_setting('app.clinica_id'::text))::uuid")) @db.Uuid
  paciente_id String   @db.Uuid
  descricao   String
  gravidade   String?
  criado_em   DateTime @default(now())

  clinica  Clinica  @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  paciente Paciente @relation(fields: [paciente_id], references: [id], onDelete: Cascade)

  @@index([clinica_id, paciente_id])
  @@map("paciente_alergias")
}

model PacienteMedicacao {
  id          String   @id @default(uuid()) @db.Uuid
  clinica_id  String   @default(dbgenerated("(current_setting('app.clinica_id'::text))::uuid")) @db.Uuid
  paciente_id String   @db.Uuid
  nome        String
  dosagem     String?
  frequencia  String?
  observacoes String?
  criado_em   DateTime @default(now())

  clinica  Clinica  @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  paciente Paciente @relation(fields: [paciente_id], references: [id], onDelete: Cascade)

  @@index([clinica_id, paciente_id])
  @@map("paciente_medicacoes")
}

model Agendamento {
  id                  String            @id @default(uuid()) @db.Uuid
  clinica_id          String            @default(dbgenerated("(current_setting('app.clinica_id'::text))::uuid")) @db.Uuid
  paciente_id         String            @db.Uuid
  profissional_id     String            @db.Uuid
  inicio              DateTime
  fim                 DateTime
  tipo                TipoAgendamento   @default(particular)
  convenio_id         String?           @db.Uuid
  status              StatusAgendamento @default(agendado)
  observacoes         String?
  /// Motivo informado no cancelamento (pela equipe ou pelo paciente via WhatsApp).
  motivo_cancelamento String?
  cancelado_em        DateTime?
  /// Usuário que criou o agendamento.
  criado_por          String?           @db.Uuid
  /// Preenchido pelo worker de lembretes (evita envio duplicado).
  lembrete_enviado_em DateTime?
  criado_em           DateTime          @default(now())
  atualizado_em       DateTime          @updatedAt

  clinica                   Clinica                  @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  paciente                  Paciente                 @relation(fields: [paciente_id], references: [id], onDelete: Restrict)
  profissional              Profissional             @relation(fields: [profissional_id], references: [id], onDelete: Restrict)
  convenio                  Convenio?                @relation(fields: [convenio_id], references: [id], onDelete: SetNull)
  criador                   Usuario?                 @relation("AgendamentoCriadoPor", fields: [criado_por], references: [id], onDelete: SetNull)
  registros                 ProntuarioRegistro[]
  mensagens                 MensagemWhatsapp[]
  movimentacoes_financeiras MovimentacaoFinanceira[]
  titulos                   Titulo[]
  solicitacao_agendamento   SolicitacaoAgendamento?
  lista_espera              ListaEspera[]
  documentos_clinicos       DocumentoClinico[]
  retornos_originados       Retorno[]                @relation("RetornoOrigem")
  retornos_agendados        Retorno[]                @relation("RetornoAgendamento")

  @@index([clinica_id])
  @@index([clinica_id, inicio])
  @@index([clinica_id, profissional_id, inicio])
  @@index([clinica_id, paciente_id])
  @@index([clinica_id, criado_em])
  @@map("agendamentos")
}

/// Prontuário IMUTÁVEL: sem update/delete (bloqueado pela extensão tenant e por trigger no banco).
/// Correção = novo registro, opcionalmente apontando para o corrigido em `corrige_registro_id`.
model ProntuarioRegistro {
  id                  String   @id @default(uuid()) @db.Uuid
  clinica_id          String   @default(dbgenerated("(current_setting('app.clinica_id'::text))::uuid")) @db.Uuid
  paciente_id         String   @db.Uuid
  profissional_id     String?  @db.Uuid
  agendamento_id      String?  @db.Uuid
  /// Usuário que escreveu o registro.
  autor_id            String?  @db.Uuid
  texto               String
  corrige_registro_id String?  @db.Uuid
  criado_em           DateTime @default(now())

  clinica      Clinica              @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  paciente     Paciente             @relation(fields: [paciente_id], references: [id], onDelete: Restrict)
  // Restrict (e não SetNull): SetNull faria UPDATE no prontuário, bloqueado pelo trigger de imutabilidade.
  profissional Profissional?        @relation(fields: [profissional_id], references: [id], onDelete: Restrict)
  agendamento  Agendamento?         @relation(fields: [agendamento_id], references: [id], onDelete: Restrict)
  autor        Usuario?             @relation("RegistroAutor", fields: [autor_id], references: [id], onDelete: Restrict)
  corrige      ProntuarioRegistro?  @relation("Correcao", fields: [corrige_registro_id], references: [id], onDelete: Restrict)
  correcoes    ProntuarioRegistro[] @relation("Correcao")
  anexos       Anexo[]

  @@index([clinica_id])
  @@index([clinica_id, paciente_id, criado_em])
  @@map("prontuario_registros")
}

model Anexo {
  id           String   @id @default(uuid()) @db.Uuid
  clinica_id   String   @default(dbgenerated("(current_setting('app.clinica_id'::text))::uuid")) @db.Uuid
  paciente_id  String   @db.Uuid
  registro_id  String?  @db.Uuid
  nome_arquivo String
  /// Caminho relativo a UPLOAD_DIR.
  caminho      String
  mime_tipo    String?
  /// Tamanho em bytes.
  tamanho      Int
  enviado_por  String?  @db.Uuid
  criado_em    DateTime @default(now())

  clinica  Clinica             @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  paciente Paciente            @relation(fields: [paciente_id], references: [id], onDelete: Restrict)
  registro ProntuarioRegistro? @relation(fields: [registro_id], references: [id], onDelete: SetNull)
  usuario  Usuario?            @relation("AnexoEnviadoPor", fields: [enviado_por], references: [id], onDelete: SetNull)

  @@index([clinica_id])
  @@index([clinica_id, paciente_id])
  @@index([clinica_id, criado_em])
  @@map("anexos")
}

/// Uma sessão WPPConnect por clínica.
model WhatsappSessao {
  id            String               @id @default(uuid()) @db.Uuid
  clinica_id    String               @unique @default(dbgenerated("(current_setting('app.clinica_id'::text))::uuid")) @db.Uuid
  nome_sessao   String               @unique
  /// Token Bearer gerado pelo WPPConnect para a sessão.
  token         String?
  status        StatusSessaoWhatsapp @default(desconectada)
  telefone      String?
  criado_em     DateTime             @default(now())
  atualizado_em DateTime             @updatedAt

  clinica Clinica @relation(fields: [clinica_id], references: [id], onDelete: Cascade)

  @@map("whatsapp_sessoes")
}

model MensagemWhatsapp {
  id                    String          @id @default(uuid()) @db.Uuid
  clinica_id            String          @default(dbgenerated("(current_setting('app.clinica_id'::text))::uuid")) @db.Uuid
  agendamento_id        String?         @db.Uuid
  paciente_id           String?         @db.Uuid
  telefone              String
  /// Nulo para mensagens de entrada.
  tipo                  TipoMensagem?
  direcao               DirecaoMensagem
  conteudo              String
  status                StatusMensagem  @default(pendente)
  erro                  String?
  /// ID da mensagem no provedor (WPPConnect / Meta).
  id_externo            String?
  enviada_em            DateTime?
  /// Avisos à recepção: quando foi marcado como lido (null = não lido).
  lida_em               DateTime?
  /// Mensagem SEM paciente cadastrado (paciente_id nulo) com consentimento dado fora do cadastro — ex.:
  /// recusa de solicitação de agendamento online, em que o visitante marcou "aceito receber WhatsApp".
  /// O worker só envia mensagem sem paciente se isto for true (ver servicos/whatsapp/envio.ts).
  consentimento_externo Boolean         @default(false)
  criado_em             DateTime        @default(now())

  clinica     Clinica      @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  agendamento Agendamento? @relation(fields: [agendamento_id], references: [id], onDelete: SetNull)
  paciente    Paciente?    @relation(fields: [paciente_id], references: [id], onDelete: SetNull)

  @@index([clinica_id])
  @@index([clinica_id, criado_em])
  @@index([clinica_id, direcao, status])
  @@index([clinica_id, telefone])
  // Índice único parcial (clinica_id, id_externo) WHERE direcao='entrada' AND id_externo IS NOT NULL
  // criado por SQL manual na migration ajustes_integracao (Prisma não suporta índice parcial).
  @@map("mensagens_whatsapp")
}

/// Log de acesso (LGPD). Gravado via logAcesso() em src/utils/logAcesso.ts.
model LogAcesso {
  id          String   @id @default(uuid()) @db.Uuid
  clinica_id  String   @default(dbgenerated("(current_setting('app.clinica_id'::text))::uuid")) @db.Uuid
  usuario_id  String?  @db.Uuid
  acao        String
  entidade    String
  entidade_id String?
  ip          String?
  user_agent  String?
  criado_em   DateTime @default(now())

  clinica Clinica  @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuario_id], references: [id], onDelete: SetNull)

  @@index([clinica_id, criado_em])
  @@index([clinica_id, entidade, entidade_id])
  @@map("logs_acesso")
}

// ----------------------------------------------------------------------------
// Fase 2 do produto — modelos de clínica (todos com clinica_id + MODELOS_DE_CLINICA em tenant.ts)
// Contratos por módulo: docs/FASE2.md
// ----------------------------------------------------------------------------

/// Configurações da clínica (1:1, criada sob demanda por `obterConfiguracaoClinica` em
/// src/servicos/configuracaoClinica.ts — nunca assuma que a linha existe).
/// Prefixo `ao_` = agendamento online; `retorno_` = retorno automático.
model ConfiguracaoClinica {
  id                            String   @id @default(uuid()) @db.Uuid
  clinica_id                    String   @unique @default(dbgenerated("(current_setting('app.clinica_id'::text))::uuid")) @db.Uuid
  /// Agendamento online ligado pela clínica (além do recurso `agendamento_online` do plano).
  ao_ativo                      Boolean  @default(false)
  /// Antecedência mínima (horas) entre agora e o horário solicitado.
  ao_antecedencia_min_horas     Int      @default(2)
  /// Até quantos dias à frente o paciente pode escolher.
  ao_dias_a_frente              Int      @default(30)
  ao_mensagem_boas_vindas       String?
  /// Máximo de solicitações PENDENTES por telefone (anti-abuso).
  ao_max_pendentes_por_telefone Int      @default(2)
  /// Envio automático do convite de retorno pelo WhatsApp.
  retorno_convite_ativo         Boolean  @default(true)
  /// Enviar o convite quando faltarem N dias para a data prevista do retorno.
  retorno_dias_antecedencia     Int      @default(7)
  criado_em                     DateTime @default(now())
  atualizado_em                 DateTime @updatedAt

  clinica Clinica @relation(fields: [clinica_id], references: [id], onDelete: Cascade)

  @@map("configuracoes_clinica")
}

/// Conta financeira da clínica (ex.: "Caixa", "Banco X"). Saldo = saldo_inicial + entradas − saídas.
model ContaFinanceira {
  id            String              @id @default(uuid()) @db.Uuid
  clinica_id    String              @default(dbgenerated("(current_setting('app.clinica_id'::text))::uuid")) @db.Uuid
  nome          String
  tipo          TipoContaFinanceira @default(caixa)
  saldo_inicial Decimal             @default(0) @db.Decimal(12, 2)
  ativo         Boolean             @default(true)
  criado_em     DateTime            @default(now())
  atualizado_em DateTime            @updatedAt

  clinica       Clinica                  @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  movimentacoes MovimentacaoFinanceira[]

  @@unique([clinica_id, nome])
  @@index([clinica_id])
  @@map("contas_financeiras")
}

/// Categoria de receita/despesa. `padrao` = criada automaticamente (categorias padrão por clínica, sob demanda).
model CategoriaFinanceira {
  id            String                  @id @default(uuid()) @db.Uuid
  clinica_id    String                  @default(dbgenerated("(current_setting('app.clinica_id'::text))::uuid")) @db.Uuid
  nome          String
  tipo          TipoCategoriaFinanceira
  padrao        Boolean                 @default(false)
  ativo         Boolean                 @default(true)
  criado_em     DateTime                @default(now())
  atualizado_em DateTime                @updatedAt

  clinica       Clinica                  @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  movimentacoes MovimentacaoFinanceira[]
  titulos       Titulo[]
  recorrencias  Recorrencia[]

  @@unique([clinica_id, tipo, nome])
  @@index([clinica_id])
  @@map("categorias_financeiras")
}

/// Movimentação de caixa (entrada/saída). NUNCA é apagada: estorno = nova movimentação de tipo
/// inverso com `estorno_de_id` (único: uma movimentação só pode ser estornada uma vez).
/// `valor` é sempre POSITIVO; o sinal vem de `tipo`.
model MovimentacaoFinanceira {
  id                  String             @id @default(uuid()) @db.Uuid
  clinica_id          String             @default(dbgenerated("(current_setting('app.clinica_id'::text))::uuid")) @db.Uuid
  tipo                TipoMovimentacao
  origem              OrigemMovimentacao @default(manual)
  /// Data da movimentação (dia no fuso da clínica).
  data                DateTime           @db.Date
  valor               Decimal            @db.Decimal(12, 2)
  conta_financeira_id String             @db.Uuid
  categoria_id        String?            @db.Uuid
  forma_pagamento     FormaPagamento
  descricao           String?
  agendamento_id      String?            @db.Uuid
  paciente_id         String?            @db.Uuid
  profissional_id     String?            @db.Uuid
  /// Título (conta a pagar/receber) cuja baixa gerou esta movimentação.
  titulo_id           String?            @db.Uuid
  /// Movimentação estornada por esta (esta é o estorno).
  estorno_de_id       String?            @unique @db.Uuid
  /// Pagamento de repasse: período de referência.
  repasse_inicio      DateTime?          @db.Date
  repasse_fim         DateTime?          @db.Date
  criado_por          String?            @db.Uuid
  criado_em           DateTime           @default(now())

  clinica       Clinica                 @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  conta         ContaFinanceira         @relation(fields: [conta_financeira_id], references: [id], onDelete: NoAction)
  categoria     CategoriaFinanceira?    @relation(fields: [categoria_id], references: [id], onDelete: SetNull)
  agendamento   Agendamento?            @relation(fields: [agendamento_id], references: [id], onDelete: SetNull)
  paciente      Paciente?               @relation(fields: [paciente_id], references: [id], onDelete: SetNull)
  profissional  Profissional?           @relation(fields: [profissional_id], references: [id], onDelete: SetNull)
  titulo        Titulo?                 @relation(fields: [titulo_id], references: [id], onDelete: SetNull)
  estorno_de    MovimentacaoFinanceira? @relation("Estorno", fields: [estorno_de_id], references: [id], onDelete: NoAction)
  estornada_por MovimentacaoFinanceira? @relation("Estorno")
  criador       Usuario?                @relation("MovimentacaoCriadaPor", fields: [criado_por], references: [id], onDelete: SetNull)

  @@index([clinica_id])
  @@index([clinica_id, data])
  @@index([clinica_id, conta_financeira_id, data])
  @@index([clinica_id, profissional_id, data])
  @@index([clinica_id, agendamento_id])
  @@index([clinica_id, titulo_id])
  @@map("movimentacoes_financeiras")
}

/// Conta a pagar / a receber. Baixa ⇒ status `pago` + movimentação (origem `titulo`, titulo_id).
/// Parcelas: mesmo `grupo_parcelas_id`, `parcela_numero`/`parcela_total`.
/// Recorrência: `recorrencia_id` + `competencia` (1º dia do mês de referência) — único por recorrência,
/// o que torna a geração mensal idempotente.
model Titulo {
  id                String          @id @default(uuid()) @db.Uuid
  clinica_id        String          @default(dbgenerated("(current_setting('app.clinica_id'::text))::uuid")) @db.Uuid
  tipo              TipoTitulo
  descricao         String
  valor             Decimal         @db.Decimal(12, 2)
  vencimento        DateTime        @db.Date
  status            StatusTitulo    @default(aberto)
  categoria_id      String?         @db.Uuid
  paciente_id       String?         @db.Uuid
  profissional_id   String?         @db.Uuid
  /// Fornecedor/credor/devedor em texto livre.
  fornecedor        String?
  forma_pagamento   FormaPagamento?
  parcela_numero    Int?            @db.SmallInt
  parcela_total     Int?            @db.SmallInt
  grupo_parcelas_id String?         @db.Uuid
  recorrencia_id    String?         @db.Uuid
  competencia       DateTime?       @db.Date
  /// Consulta de origem (ex.: título a receber do convênio lançado pelo painel da agenda).
  agendamento_id    String?         @db.Uuid
  observacoes       String?
  pago_em           DateTime?
  valor_pago        Decimal?        @db.Decimal(12, 2)
  cancelado_em      DateTime?
  criado_por        String?         @db.Uuid
  criado_em         DateTime        @default(now())
  atualizado_em     DateTime        @updatedAt

  clinica       Clinica                  @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  categoria     CategoriaFinanceira?     @relation(fields: [categoria_id], references: [id], onDelete: SetNull)
  paciente      Paciente?                @relation(fields: [paciente_id], references: [id], onDelete: SetNull)
  profissional  Profissional?            @relation(fields: [profissional_id], references: [id], onDelete: SetNull)
  recorrencia   Recorrencia?             @relation(fields: [recorrencia_id], references: [id], onDelete: SetNull)
  agendamento   Agendamento?             @relation(fields: [agendamento_id], references: [id], onDelete: SetNull)
  movimentacoes MovimentacaoFinanceira[]

  @@unique([recorrencia_id, competencia])
  @@index([clinica_id])
  @@index([clinica_id, agendamento_id])
  @@index([clinica_id, tipo, status, vencimento])
  @@index([clinica_id, grupo_parcelas_id])
  @@map("titulos")
}

/// Modelo recorrente (ex.: mensalidade de paciente, aluguel) que gera um título por mês.
/// Geração: ao criar + job diário (fila FINANCEIRO_RECORRENCIAS) que gera o do próximo mês com
/// antecedência. `ultima_competencia` = último mês gerado.
model Recorrencia {
  id                 String                @id @default(uuid()) @db.Uuid
  clinica_id         String                @default(dbgenerated("(current_setting('app.clinica_id'::text))::uuid")) @db.Uuid
  tipo               TipoTitulo
  descricao          String
  valor              Decimal               @db.Decimal(12, 2)
  /// 1–31 (meses mais curtos: último dia do mês).
  dia_vencimento     Int                   @db.SmallInt
  frequencia         FrequenciaRecorrencia @default(mensal)
  inicio             DateTime              @db.Date
  fim                DateTime?             @db.Date
  ativo              Boolean               @default(true)
  categoria_id       String?               @db.Uuid
  paciente_id        String?               @db.Uuid
  profissional_id    String?               @db.Uuid
  fornecedor         String?
  forma_pagamento    FormaPagamento?
  ultima_competencia DateTime?             @db.Date
  criado_por         String?               @db.Uuid
  criado_em          DateTime              @default(now())
  atualizado_em      DateTime              @updatedAt

  clinica      Clinica              @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  categoria    CategoriaFinanceira? @relation(fields: [categoria_id], references: [id], onDelete: SetNull)
  paciente     Paciente?            @relation(fields: [paciente_id], references: [id], onDelete: SetNull)
  profissional Profissional?        @relation(fields: [profissional_id], references: [id], onDelete: SetNull)
  titulos      Titulo[]

  @@index([clinica_id])
  @@index([clinica_id, ativo])
  @@map("recorrencias")
}

/// Solicitação feita pelo paciente na página pública /agendar/:slug. Não consome max_agendamentos
/// até ser APROVADA (a aprovação cria o agendamento com as validações normais + assegurarLimite).
model SolicitacaoAgendamento {
  id              String                       @id @default(uuid()) @db.Uuid
  clinica_id      String                       @default(dbgenerated("(current_setting('app.clinica_id'::text))::uuid")) @db.Uuid
  profissional_id String                       @db.Uuid
  inicio          DateTime
  fim             DateTime
  status          StatusSolicitacaoAgendamento @default(pendente)
  nome            String
  /// Só dígitos, formato internacional (normalizarTelefone).
  telefone        String
  email           String?
  /// Só dígitos.
  cpf             String?
  nascimento      DateTime?                    @db.Date
  observacoes     String?
  /// Consentimento LGPD de WhatsApp dado no formulário público.
  aceita_whatsapp Boolean                      @default(false)
  /// Paciente casado/criado na aprovação.
  paciente_id     String?                      @db.Uuid
  agendamento_id  String?                      @unique @db.Uuid
  motivo_recusa   String?
  analisado_por   String?                      @db.Uuid
  analisado_em    DateTime?
  ip              String?
  user_agent      String?
  criado_em       DateTime                     @default(now())
  atualizado_em   DateTime                     @updatedAt

  clinica      Clinica      @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  profissional Profissional @relation(fields: [profissional_id], references: [id], onDelete: Cascade)
  paciente     Paciente?    @relation(fields: [paciente_id], references: [id], onDelete: SetNull)
  agendamento  Agendamento? @relation(fields: [agendamento_id], references: [id], onDelete: SetNull)

  @@index([clinica_id])
  @@index([clinica_id, status, criado_em])
  @@index([clinica_id, telefone, status])
  @@map("solicitacoes_agendamento")
}

/// Lista de espera: paciente aguardando vaga (opcionalmente com um profissional específico).
model ListaEspera {
  id               String            @id @default(uuid()) @db.Uuid
  clinica_id       String            @default(dbgenerated("(current_setting('app.clinica_id'::text))::uuid")) @db.Uuid
  paciente_id      String            @db.Uuid
  profissional_id  String?           @db.Uuid
  /// Dias da semana preferidos (0 = domingo … 6 = sábado). Vazio = qualquer dia.
  dias_semana      Int[]             @db.SmallInt
  /// Turnos preferidos. Vazio = qualquer turno. manhã < 12h, tarde 12–18h, noite ≥ 18h (fuso da clínica).
  turnos           Turno[]
  observacao       String?
  status           StatusListaEspera @default(aguardando)
  /// Agendamento criado para este item (status `agendado`).
  agendamento_id   String?           @db.Uuid
  /// Última oferta de horário enviada pelo WhatsApp.
  ultima_oferta_em DateTime?
  criado_por       String?           @db.Uuid
  criado_em        DateTime          @default(now())
  atualizado_em    DateTime          @updatedAt

  clinica      Clinica       @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  paciente     Paciente      @relation(fields: [paciente_id], references: [id], onDelete: Cascade)
  profissional Profissional? @relation(fields: [profissional_id], references: [id], onDelete: SetNull)
  agendamento  Agendamento?  @relation(fields: [agendamento_id], references: [id], onDelete: SetNull)

  @@index([clinica_id])
  @@index([clinica_id, status, criado_em])
  @@index([clinica_id, paciente_id])
  @@map("lista_espera")
}

/// Documento clínico emitido (receita, atestado, declaração, pedido de exame). IMUTÁVEL como o
/// prontuário: sem update/delete (extensão tenant + trigger `documentos_clinicos_imutavel`).
/// Correção = novo documento. O PDF é gerado sob demanda a partir destes dados (não é armazenado).
model DocumentoClinico {
  id              String               @id @default(uuid()) @db.Uuid
  clinica_id      String               @default(dbgenerated("(current_setting('app.clinica_id'::text))::uuid")) @db.Uuid
  tipo            TipoDocumentoClinico
  paciente_id     String               @db.Uuid
  profissional_id String               @db.Uuid
  agendamento_id  String?              @db.Uuid
  /// Usuário que emitiu.
  autor_id        String?              @db.Uuid
  titulo          String?
  conteudo        String
  /// Dados específicos do tipo (ex.: atestado { dias, cid }, pedido_exame { exames: [] }).
  metadados       Json?
  criado_em       DateTime             @default(now())

  clinica      Clinica      @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  // NoAction (e não SetNull): SetNull faria UPDATE, bloqueado pelo trigger de imutabilidade. NoAction (e não
  // Restrict) é checado no fim do comando: a exclusão em cascata da clínica inteira funciona.
  paciente     Paciente     @relation(fields: [paciente_id], references: [id], onDelete: NoAction)
  profissional Profissional @relation(fields: [profissional_id], references: [id], onDelete: NoAction)
  agendamento  Agendamento? @relation(fields: [agendamento_id], references: [id], onDelete: NoAction)
  autor        Usuario?     @relation("DocumentoAutor", fields: [autor_id], references: [id], onDelete: NoAction)

  @@index([clinica_id])
  @@index([clinica_id, paciente_id, criado_em])
  @@map("documentos_clinicos")
}

/// Retorno previsto ("retorno em X dias"), criado ao finalizar um atendimento. Um por agendamento de origem.
model Retorno {
  id                     String        @id @default(uuid()) @db.Uuid
  clinica_id             String        @default(dbgenerated("(current_setting('app.clinica_id'::text))::uuid")) @db.Uuid
  paciente_id            String        @db.Uuid
  profissional_id        String        @db.Uuid
  agendamento_origem_id  String        @unique @db.Uuid
  data_prevista          DateTime      @db.Date
  status                 StatusRetorno @default(pendente)
  agendamento_retorno_id String?       @db.Uuid
  observacao             String?
  convite_enviado_em     DateTime?
  criado_por             String?       @db.Uuid
  criado_em              DateTime      @default(now())
  atualizado_em          DateTime      @updatedAt

  clinica             Clinica      @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  paciente            Paciente     @relation(fields: [paciente_id], references: [id], onDelete: Cascade)
  profissional        Profissional @relation(fields: [profissional_id], references: [id], onDelete: Cascade)
  agendamento_origem  Agendamento  @relation("RetornoOrigem", fields: [agendamento_origem_id], references: [id], onDelete: Cascade)
  agendamento_retorno Agendamento? @relation("RetornoAgendamento", fields: [agendamento_retorno_id], references: [id], onDelete: SetNull)

  @@index([clinica_id])
  @@index([clinica_id, status, data_prevista])
  @@index([clinica_id, paciente_id])
  @@map("retornos")
}

// ============================================================================
// E-mails transacionais (plataforma — acesso só pelo prisma cru; proibidos via request.db)
// ============================================================================

/// Configuração do envio (linha única, id = 1). SMTP genérico (Resend, Brevo, SES, Hostinger…).
model ConfiguracaoEmail {
  id                 Int      @id @default(1)
  ativo              Boolean  @default(false)
  smtp_host          String   @default("smtp.resend.com")
  smtp_porta         Int      @default(465)
  /// true = TLS implícito (porta 465); false = STARTTLS (porta 587).
  smtp_seguro        Boolean  @default(true)
  smtp_usuario       String   @default("resend")
  /// Senha / API key cifrada (utils/cripto.ts).
  smtp_senha_cifrada String?
  smtp_senha_final   String?  @db.VarChar(4)
  remetente_nome     String   @default("Sistema Clínica")
  remetente_email    String?
  responder_para     String?
  atualizado_em      DateTime @updatedAt

  @@map("configuracao_email")
}

/// Texto editável de cada e-mail. Sem linha para o tipo ⇒ usa o padrão do código (servicos/email/modelosPadrao.ts).
model ModeloEmail {
  tipo          TipoEmail @id
  assunto       String
  /// Corpo com marcação simples (parágrafos, **negrito**, listas "- ") e variáveis {nome}.
  corpo         String
  texto_botao   String
  ativo         Boolean   @default(true)
  atualizado_em DateTime  @updatedAt

  @@map("modelos_email")
}

/// Histórico de envios. (tipo, referencia) único ⇒ o mesmo evento nunca gera dois e-mails.
model EmailEnviado {
  id            String      @id @default(uuid()) @db.Uuid
  tipo          TipoEmail
  /// Chave de idempotência (ex.: id da cobrança, id do usuário, id do token). null = sem controle (teste).
  referencia    String?
  clinica_id    String?     @db.Uuid
  destinatario  String
  assunto       String
  /// HTML e texto já montados no momento do enfileiramento.
  html          String
  texto         String
  status        StatusEmail @default(pendente)
  erro          String?
  tentativas    Int         @default(0)
  id_externo    String?
  enviado_em    DateTime?
  criado_em     DateTime    @default(now())
  atualizado_em DateTime    @updatedAt

  clinica Clinica? @relation(fields: [clinica_id], references: [id], onDelete: SetNull)

  @@unique([tipo, referencia, destinatario])
  @@index([criado_em])
  @@index([status, criado_em])
  @@map("emails_enviados")
}

/// Link de "esqueci minha senha" (usuário da clínica). Só o hash SHA-256 do token é gravado.
model TokenRedefinicaoSenha {
  id         String    @id @default(uuid()) @db.Uuid
  usuario_id String    @db.Uuid
  token_hash String    @unique @db.VarChar(64)
  expira_em  DateTime
  usado_em   DateTime?
  ip         String?
  criado_em  DateTime  @default(now())

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id])
  @@map("tokens_redefinicao_senha")
}
