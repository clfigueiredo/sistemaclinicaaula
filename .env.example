# ============================================================
# Sistema Clínica — variáveis de ambiente
# Copie para .env (na RAIZ do projeto). O docker compose, a API e o
# Prisma leem este mesmo arquivo. Nunca commite o .env.
# ============================================================

# --- Postgres (docker-compose) ---
POSTGRES_USER=clinica
POSTGRES_PASSWORD=clinica
POSTGRES_DB=clinica
DATABASE_URL=postgresql://clinica:clinica@localhost:5432/clinica?schema=public
# Banco usado pelos testes (vitest). É criado automaticamente pelos testes.
DATABASE_URL_TESTE=postgresql://clinica:clinica@localhost:5432/clinica_teste?schema=public

# --- Redis / BullMQ ---
# Senha do Redis (o docker-compose sobe o Redis com --requirepass). Gere com: openssl rand -hex 32
REDIS_PASSWORD=troque-esta-senha-do-redis
REDIS_URL=redis://:troque-esta-senha-do-redis@localhost:6379

# --- API ---
NODE_ENV=development
PORT=3333
# Interface em que a API escuta. Em dev, 0.0.0.0 permite que o WPPConnect (Docker) chame o webhook via
# host.docker.internal; use 127.0.0.1 se não precisar do webhook.
HOST=0.0.0.0
# Proxy reverso confiável (IP real do cliente no rate limit do login e em logs_acesso).
# false = ignora X-Forwarded-For (dev, API exposta direto). Produção atrás do Caddy: TRUST_PROXY=1
TRUST_PROXY=false
# URL do front (CORS). Aceita várias separadas por vírgula.
WEB_URL=http://localhost:5173
# Em produção (NODE_ENV=production) a API RECUSA subir com JWT_SECRET, WEBHOOK_TOKEN ou
# WPPCONNECT_SECRET_KEY com menos de 32 caracteres ou contendo "troque"/"exemplo"/"changeme", ou com
# REDIS_URL sem senha. Em desenvolvimento só mostra um aviso. Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria-com-32+-caracteres
JWT_EXPIRA_EM=12h
LOG_LEVEL=info
# Executar os workers BullMQ no mesmo processo da API (dev). Em produção use `npm run start:worker`.
EXECUTAR_WORKERS=true

# --- Uploads (anexos) ---
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=10

# --- WPPConnect ---
WPPCONNECT_URL=http://localhost:21465
WPPCONNECT_SECRET_KEY=troque-esta-chave
# Token enviado pelo WPPConnect na query do webhook (?token=...) para autenticar a chamada.
WEBHOOK_TOKEN=troque-este-token
# Fuso horário padrão para cálculo de "mês corrente" dos limites e lembretes.
TZ_PADRAO=America/Sao_Paulo

# --- Fase 2 do produto ---
# Chave AES-256-GCM (64 caracteres hex = 32 bytes) que cifra segredos no banco (credenciais dos gateways
# de pagamento). OBRIGATÓRIA em produção. Trocar a chave invalida os segredos já gravados.
# Gere com: openssl rand -hex 32
CHAVE_CRIPTOGRAFIA=
# URL pública da API (webhooks dos gateways: <API_URL_PUBLICA>/webhooks/pagamentos/<asaas|stripe|mercado_pago>).
API_URL_PUBLICA=http://localhost:3333
# URL pública do front (links enviados ao paciente, ex.: <WEB_URL_PUBLICA>/agendar/<slug>). Vazio = WEB_URL.
WEB_URL_PUBLICA=

# --- Web (Vite) ---
# Em dev o Vite faz proxy de /api -> http://localhost:3333. Só defina se quiser apontar para outra API.
# VITE_API_URL=http://localhost:3333
