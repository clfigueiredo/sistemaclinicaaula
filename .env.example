# ============================================================
# Sistema Clínica — variáveis de ambiente
# Copie para .env (na RAIZ do projeto). O docker compose, a API e o
# Prisma leem este mesmo arquivo. Nunca commite o .env.
# ============================================================

# --- Postgres (docker-compose) ---
POSTGRES_USER=clinica
POSTGRES_PASSWORD=clinica
POSTGRES_DB=clinica
DATABASE_URL=postgresql://clinica:clinica@localhost:5432/clinica?schema=public
# Banco usado pelos testes (vitest). É criado automaticamente pelos testes.
DATABASE_URL_TESTE=postgresql://clinica:clinica@localhost:5432/clinica_teste?schema=public

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- API ---
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
# URL do front (CORS). Aceita várias separadas por vírgula.
WEB_URL=http://localhost:5173
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria-com-32+-caracteres
JWT_EXPIRA_EM=12h
LOG_LEVEL=info
# Executar os workers BullMQ no mesmo processo da API (dev). Em produção use `npm run start:worker`.
EXECUTAR_WORKERS=true

# --- Uploads (anexos) ---
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=10

# --- WPPConnect ---
WPPCONNECT_URL=http://localhost:21465
WPPCONNECT_SECRET_KEY=troque-esta-chave
# Token enviado pelo WPPConnect na query do webhook (?token=...) para autenticar a chamada.
WEBHOOK_TOKEN=troque-este-token
# Fuso horário padrão para cálculo de "mês corrente" dos limites e lembretes.
TZ_PADRAO=America/Sao_Paulo

# --- Web (Vite) ---
# Em dev o Vite faz proxy de /api -> http://localhost:3333. Só defina se quiser apontar para outra API.
# VITE_API_URL=http://localhost:3333
